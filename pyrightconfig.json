{
    "include": [
        "backend"
    ],
    "exclude": [
        "**/__pycache__",
        "**/venv",
        ".gemini/**"
    ],
    "pythonVersion": "3.11",
    "venvPath": ".",
    "venv": ".venv",
    "extraPaths": [
        "backend",
        "backend/api",
        "backend/authentication"
    ],
    "reportMissingImports": false,
    "reportMissingTypeStubs": false,
    "typeCheckingMode": "off"
}
